generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth / Users ────────────────────────────────────────────────────────────

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  displayName      String?
  createdAt        DateTime      @default(now())
  characters       Character[]
  partyMemberships PartyMember[]
}

// ==========================================
// 1. MASTER BLUEPRINTS / CATALOGS (Read-Only Templates)
// ==========================================

model DungeonTemplate {
  id                  String         @id @default(uuid())
  name                String
  globalStyle         String
  synopsis            String         @default("")
  difficulty          String         @default("Standard")
  length              String         @default("Short")
  tone                String         @default("")
  startRoomTemplateId String?
  roomTemplates       RoomTemplate[]
  gameSessions        GameSession[]
}

model RoomTemplate {
  id                     String          @id @default(uuid())
  dungeonTemplateId      String
  dungeonTemplate        DungeonTemplate @relation(fields: [dungeonTemplateId], references: [id], onDelete: Cascade)
  name                   String
  baseDescription        String
  searchFailureNarrative String
  map_x                  Int             @default(0)
  map_y                  Int             @default(0)
  poiTemplates           PoiTemplate[]
  roomInstances          RoomInstance[]
}

model PoiTemplate {
  id                String        @id @default(uuid())
  roomTemplateId    String
  roomTemplate      RoomTemplate  @relation(fields: [roomTemplateId], references: [id], onDelete: Cascade)
  name              String
  keywordIdentifier String
  defaultProperties Json
  grid_slot         String        @default("C")
  visibility_level  Int           @default(1)
  exit_direction    String?
  exit_wall_section String        @default("C")
  exit_arch_width   Int           @default(1)
  poiInstances      PoiInstance[]
}

// ==========================================
// 2. ACTIVE INSTANCES (The Dynamic Player Sessions)
// ==========================================

model GameSession {
  id                String           @id @default(uuid())
  name              String
  gameState         String           @default("exploration")
  combatState       Json?
  currentObjective  String?
  storyFlags        Json             @default("{}")
  dungeonTemplateId String?
  dungeonTemplate   DungeonTemplate? @relation(fields: [dungeonTemplateId], references: [id])
  createdAt         DateTime         @default(now())
  roomInstances     RoomInstance[]
  gameMaps          GameMap[]
}

model RoomInstance {
  id              String            @id @default(uuid())
  sessionId       String
  session         GameSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roomTemplateId  String
  template        RoomTemplate      @relation(fields: [roomTemplateId], references: [id])
  inGameTimestamp DateTime          @default(now())
  poiInstances    PoiInstance[]
  participants    RoomParticipant[]
  messages        MessageLog[]
  game            Game?             @relation(fields: [gameId], references: [id])
  gameId          String?
}

model PoiInstance {
  id                String       @id @default(uuid())
  roomInstanceId    String
  roomInstance      RoomInstance @relation(fields: [roomInstanceId], references: [id], onDelete: Cascade)
  poiTemplateId     String
  template          PoiTemplate  @relation(fields: [poiTemplateId], references: [id])
  isStateModified   Boolean      @default(false)
  currentProperties Json // Stores current changes (e.g., if a chest becomes "unlocked")
}

model Character {
  userId String
  user   User   @relation(fields: [userId], references: [id])

  id              String            @id @default(uuid())
  name            String
  characterClass  String            @default("Fighter")
  xp              Int               @default(0)
  level           Int               @default(1)
  maxHp           Int               @default(12)
  currentHp       Int               @default(12)
  skillsModifiers Json              @default("{}")
  inventory       Json              @default("{}")
  participants    RoomParticipant[]
  messages        MessageLog[]
  // end MVP fields //

  baseStrength     Int @default(8)
  baseDexterity    Int @default(8)
  baseConstitution Int @default(8)
  baseIntelligence Int @default(8)
  baseWisdom       Int @default(8)
  baseCharisma     Int @default(8)

  skillProficiencies String[] @default([])

  mainHandId String?
  mainHand   Item?   @relation("CharacterMainHand", fields: [mainHandId], references: [id])
  offHandId  String?
  offHand    Item?   @relation("CharacterOffHand", fields: [offHandId], references: [id])
  armorId    String?
  armor      Item?   @relation("CharacterArmor", fields: [armorId], references: [id])
  ringId     String?
  ring       Item?   @relation("CharacterRing", fields: [ringId], references: [id])

  remainingActions            Int     @default(1)
  remainingObjectInteractions Int     @default(1)
  remainingBonusActions       Int     @default(1)
  remainingMovementFeet       Int     @default(30)
  remainingReactions          Int     @default(1)
  hasCastedBonusSpell         Boolean @default(false)

  activeConditions String[] @default([])
  backpack         String[] @default([])

  posX        Int     @default(0)
  posY        Int     @default(0)
  isHiding    Boolean @default(false)
  stealthRoll Int     @default(0)

  games            Game[]
  partyMemberships PartyMember[]
}

model RoomParticipant {
  id             String       @id @default(uuid())
  roomInstanceId String
  roomInstance   RoomInstance @relation(fields: [roomInstanceId], references: [id], onDelete: Cascade)
  characterId    String
  character      Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  combatState    Json // { "proximity_target_id": "poi_instance_id", "stance": "elevated_ground" }
  lastActiveAt   DateTime     @default(now())
  room           Room?        @relation(fields: [roomId], references: [id])
  roomId         String?

  @@unique([roomInstanceId, characterId])
}

model MessageLog {
  id                String       @id @default(uuid())
  roomInstanceId    String
  roomInstance      RoomInstance @relation(fields: [roomInstanceId], references: [id], onDelete: Cascade)
  characterId       String?
  character         Character?   @relation(fields: [characterId], references: [id], onDelete: SetNull)
  isMechanicalEvent Boolean      @default(false)
  mechanicalSummary Json?
  text              String
  createdAt         DateTime     @default(now())
  room              Room?        @relation(fields: [roomId], references: [id])
  roomId            String?
}

// VIEW MODEL FOR THE FRONTEND UI
// Prisma helper model to represent the client's current context
model ClientStateView {
  id                  String @id @default(uuid())
  roomId              String
  roomName            String
  currentNarrative    String
  activeState         String // "exploration" or "combat"
  uiLayoutAnchors     Json // Groups players/monsters into visual room cards instantly
  mechanicalFeedSince Json // Bulleted list updates since last visit
}

// ─── Items ────────────────────────────────────────────────────────────────────

model Item {
  id   String @id @default(uuid())
  name String
  type String @default("")

  statKey           String?
  statModifierBonus Int     @default(0)

  category          String   @default("")
  description       String   @default("")
  weightLbs         Float    @default(0)
  quantity          Int      @default(1)
  isEquipped        Boolean  @default(false)
  combatImpactLabel String   @default("")
  weaponType        String   @default("melee")
  rangeFeet         Int      @default(5)
  damageDice        String   @default("1d4")
  attackBonus       Int      @default(0)
  blocksMovement    Boolean  @default(false)
  interactionTags   String[] @default([])
  keyId             String?

  equippedAsMainHand      Character[] @relation("CharacterMainHand")
  equippedAsOffHand       Character[] @relation("CharacterOffHand")
  equippedAsArmor         Character[] @relation("CharacterArmor")
  equippedAsRing          Character[] @relation("CharacterRing")
  equippedAsEnemyMainHand Enemy[]     @relation("EnemyMainHand")
}

// ─── Story / Act / Scene ──────────────────────────────────────────────────────

model Story {
  id          String @id @default(uuid())
  title       String @unique
  description String // Short blurb shown in game selection
  difficulty  String @default("Standard") // Beginner | Standard | Veteran

  acts  Act[]
  games Game[]
}

model Act {
  id                      String @id @default(uuid())
  storyId                 String
  story                   Story  @relation(fields: [storyId], references: [id])
  order                   Int // 1-based within the story
  title                   String
  summary                 String // Always fed to AI DM — enables foreshadowing
  playerFacingDescription String // Shown to players when act begins

  map      Map?
  scenes   Scene[]
  enemies  Enemy[]
  games    Game[]
  gameMaps GameMap[]

  @@unique([storyId, order])
  @@index([storyId])
}

model Scene {
  id          String   @id @default(uuid())
  actId       String
  act         Act      @relation(fields: [actId], references: [id])
  order       Int // 1-based within the act
  title       String
  description String // Full scene brief fed to AI DM on entry
  objectives  String[]

  // Scene 1 of each act uses ACT_START; others require a trigger.
  triggerType      SceneTriggerType
  triggerEnemyId   String? // ENEMY_DEFEATED: enemy id whose death fires this
  triggerItemId    String? // ITEM_FOUND: item id pickup that fires this
  triggerAreaX     Int? // AREA_REACHED: tile x
  triggerAreaY     Int? // AREA_REACHED: tile y
  triggerTurnLimit Int? // TURN_LIMIT: AI forces progression after N scene turns

  // Written by AI when scene ends; replaces full message log for past-scene context
  summary     String?
  completedAt DateTime?

  enemies  Enemy[]
  messages Message[]
  games    Game[]

  @@unique([actId, order])
  @@index([actId])
}

model Enemy {
  id      String @id @default(uuid())
  actId   String
  act     Act    @relation(fields: [actId], references: [id])
  sceneId String // activates when this scene starts
  scene   Scene  @relation(fields: [sceneId], references: [id])

  name        String
  description String @default("")

  maxHp        Int
  strength     Int @default(10)
  dexterity    Int @default(10)
  constitution Int @default(10)
  intelligence Int @default(10)
  wisdom       Int @default(10)
  charisma     Int @default(10)

  armorClass  Int    @default(10)
  attackBonus Int    @default(0)
  damageDice  String // e.g. "1d6+2"

  mainHandId String?
  mainHand   Item?   @relation("EnemyMainHand", fields: [mainHandId], references: [id])

  @@index([actId])
  @@index([sceneId])
}

enum SceneTriggerType {
  ACT_START // auto-fires when act begins (always used for scene 1)
  AREA_REACHED // any party member steps on triggerAreaX/Y
  ENEMY_DEFEATED // triggerEnemyId is killed
  ITEM_FOUND // triggerItemId is picked up
  TURN_LIMIT // AI DM forces transition after triggerTurnLimit turns
}

model Map {
  id   String @id @default(uuid())
  name String @unique
  // { width, height, tiles[][], playerStart: {x,y}, rooms[], pois[] }
  data Json

  actId String? @unique // one map per act
  act   Act?    @relation(fields: [actId], references: [id])

  gameMaps GameMap[]
}

model GameMap {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String      @default("")
  rooms     Room[]
  // END MVP FIELDS

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  actId  String
  act    Act    @relation(fields: [actId], references: [id])
  mapId  String
  map    Map    @relation(fields: [mapId], references: [id])
  // Full per-game map state: tiles, rooms, pois, items[], enemies[]
  data   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, actId])
  @@index([gameId])
}

model Room {
  id                     String            @id @default(uuid())
  mapId                  String
  map                    GameMap           @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name                   String
  baseDescription        String
  searchFailureNarrative String
  inGameTimestamp        DateTime          @default(now())
  pointsOfInterest       PointOfInterest[]
  participants           RoomParticipant[]
  messages               MessageLog[]
}

model PointOfInterest {
  id                String  @id @default(uuid())
  roomId            String
  room              Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name              String // e.g., "stone_fountain"
  keywordIdentifier String // e.g., "fountain"
  isHidden          Boolean @default(false)
  combatProperties  Json // Rules dictionary: { "climb": { "resulting_stance": "elevated_ground" } }
}

// ─── Active Game ──────────────────────────────────────────────────────────────

model Game {
  id        String    @id @default(uuid())
  name      String    @default("")
  gameState String    @default("exploration") // "exploration" or "combat"
  createdAt DateTime  @default(now())
  gameMaps  GameMap[]

  characterId String
  character   Character @relation(fields: [characterId], references: [id])

  storyId String?
  story   Story?  @relation(fields: [storyId], references: [id])

  currentActId String?
  currentAct   Act?    @relation(fields: [currentActId], references: [id])

  currentSceneId String?
  currentScene   Scene?  @relation(fields: [currentSceneId], references: [id])

  status GameStatus @default(ACTIVE)
  phase  GamePhase  @default(ACTIVE)

  currentTurnCharacterId String?

  state   Json
  version Int  @default(0)

  worldState            Json?
  narrativeHistory      String[] @default([])
  activeSuggestionChips Json?

  updatedAt        DateTime          @updatedAt
  messages         Message[]
  partyMembers     PartyMember[]
  pendingRolls     PendingRoll[]
  activeTurnQueues ActiveTurnQueue[]
  combatSession    CombatSession?

  roomInstances RoomInstance[]
}

enum GameStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum GamePhase {
  LOBBY
  ACTIVE
  COMPLETED
}

// ─── Party ────────────────────────────────────────────────────────────────────

model PartyMember {
  id          String       @id @default(uuid())
  gameId      String
  game        Game         @relation(fields: [gameId], references: [id])
  characterId String
  character   Character    @relation(fields: [characterId], references: [id])
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  status      MemberStatus @default(JOINED)
  turnOrder   Int          @default(0)
  joinedAt    DateTime     @default(now())

  posX        Int     @default(0)
  posY        Int     @default(0)
  isHiding    Boolean @default(false)
  stealthRoll Int     @default(0)
}

enum MemberStatus {
  JOINED
  READY
}

// ─── Message Log ──────────────────────────────────────────────────────────────

model Message {
  id      String      @id @default(uuid())
  gameId  String
  game    Game        @relation(fields: [gameId], references: [id])
  role    MessageRole
  content String
  chips   Json?

  // Scoped to the active scene when written — enables per-scene context windowing
  sceneId String?
  scene   Scene?  @relation(fields: [sceneId], references: [id])

  createdAt DateTime @default(now())
}

enum MessageRole {
  PLAYER
  DUNGEON_MASTER
}

// ─── Class Progression ───────────────────────────────────────────────────────

model ClassProgression {
  id               String   @id @default(uuid())
  characterClass   String
  level            Int
  proficiencyBonus Int
  featuresUnlocked String[]
  resourcePoolMax  Int?

  features ClassFeature[]

  @@unique([characterClass, level])
  @@index([characterClass])
}

// ─── Class Feature ───────────────────────────────────────────────────────────

model ClassFeature {
  id             String @id @default(uuid())
  characterClass String
  level          Int
  name           String
  description    String
  icon           String @default("🍃")
  costType       String @default("free")

  classProgression ClassProgression @relation(fields: [characterClass, level], references: [characterClass, level])

  @@index([characterClass, level])
}

// ─── Active Turn Queue ────────────────────────────────────────────────────────

model ActiveTurnQueue {
  id               String          @id @default(uuid())
  gameId           String
  game             Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  characterId      String
  status           TurnQueueStatus @default(PENDING_ROLLS)
  currentRollIndex Int             @default(0)
  rolls            Json
  createdAt        DateTime        @default(now())
  expiresAt        DateTime

  @@index([gameId])
}

enum TurnQueueStatus {
  PENDING_ROLLS
  COMPLETED
}

// ─── Combat Session ───────────────────────────────────────────────────────────

model CombatSession {
  id                 String   @id @default(uuid())
  gameId             String   @unique
  game               Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  initiativeOrder    Json
  currentTurnIndex   Int      @default(0)
  currentRoundNumber Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── Server-Seeded Roll ───────────────────────────────────────────────────────

model PendingRoll {
  id        String   @id @default(uuid())
  requestId String   @unique
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  d20       Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([gameId])
}
